<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<div class="container mt-5 pb-4" style="max-width: 500px;">
  <h2 class="mb-4 text-center page-title">Create Account</h2>

  <% if (errors && errors.length > 0) { %>
    <% errors.forEach(error => { %>
      <div class="alert alert-danger alert-dismissible fade show">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% }) %>
  <% } %>

  <% if (info && info.length > 0) { %>
    <% info.forEach(msg => { %>
      <div class="alert alert-success alert-dismissible fade show">
        <%= msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% }) %>
  <% } %>

  <div class="section-card p-4">
    <form method="POST" action="/sessions/register">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label">Name</label>
        <input
          type="text"
          name="name"
          class="form-control"
          placeholder="Enter your name"
          minlength="3"
          maxlength="50"
          required
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Email</label>
        <input
          type="email"
          name="email"
          class="form-control"
          placeholder="Enter your email"
          required
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Password</label>
        <input
          type="password"
          name="password"
          class="form-control"
          placeholder="Enter password"
          minlength="6"
          required
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Confirm Password</label>
        <input
          type="password"
          name="password1"
          class="form-control"
          placeholder="Confirm password"
          required
        >
      </div>

      <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn-add flex-grow-1">Register</button>
        <a href="/" class="btn-cancel">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"></script>
<%- include("partials/footer.ejs") %>

