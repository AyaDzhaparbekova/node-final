<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<div class="container mt-5" style="max-width: 540px;">
  <h2 class="mb-4 text-center">Profile Info</h2>

  <% if (locals.success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  <% if (locals.errors) { %>
    <% errors.forEach(e => { %>
      <div class="alert alert-danger"><%= e %></div>
    <% }) %>
  <% } %>

  <form method="POST" action="/sensitive" class="mt-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="mb-3">
  
      <label for="clubs" class="form-label">About</label>
      <input
        type="text"
        name="clubs"
        id="clubs"
        class="form-control"
        value="<%= sensitiveInfo.clubs %>"
        placeholder=
      >
    </div>

    <div class="mb-3">
      <label for="homework" class="form-label">Contacts</label>
      <input
        type="text"
        name="homework"
        id="homework"
        class="form-control"
        value="<%= sensitiveInfo.homework %>"
        placeholder=>
    </div>

    <div class="mb-3">
      <label for="sports" class="form-label">Email</label>
      <input
        type="text"
        name="sports"
        id="sports"
        class="form-control"
        value="<%= sensitiveInfo.sports %>"
        placeholder=""
      />
    </div>

    <div class="d-flex gap-2 justify-content-center mt-4">
      <button type="submit" class="btn btn-primary px-4"> Save</button>
      <a href="/tasks" class="btn btn-secondary px-4">← Back to Tasks</a>
    </div>
  </form>
</div>

<%- include("partials/footer.ejs") %>