
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo">Navi Kids</a>
    <nav class="header-nav">
<% if (locals.user) { %>
      <span class="nav-user">👤 <%= user.name %></span>
      <a href="/tasks" class="nav-link-white">My Tasks</a>
      <a href="/tasks/new?private=true" class="nav-link-white"> New Task</a>
      <a href="/profile" class="nav-link-white"> Profile</a>
      <form method="POST" action="/sessions/logoff" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <button class="btn-nav-signout">Sign out</button>
      </form>
<% } else { %>
      <a href="/sessions/logon" class="nav-link-white">Login</a>
      <a href="/sessions/register" class="nav-link-white">Register</a>
<% } %>
    </nav>
  </div>
</header>
<% if (locals.success && locals.success.length > 0) { %>
<% locals.success.forEach(function(msg) { %>
  <div class="alert alert-success alert-dismissible fade show mx-3 mt-2">
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% }) %>
<% } %>
<% if (locals.errors && locals.errors.length > 0) { %>
<% locals.errors.forEach(function(err) { %>
  <div class="alert alert-danger alert-dismissible fade show mx-3 mt-2">
    <%= err %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% }) %>
<% } %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"></script>
